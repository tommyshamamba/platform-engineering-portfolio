# Copy to .env and adjust. Nothing here is secret: the relay reads the public
# Arbitrum One feed and needs no API key or wallet.
NITRO_IMAGE=offchainlabs/nitro-node:v3.9.2-52e8959
FEED_INPUT_URL=wss://arb1-feed.arbitrum.io/feed
CHAIN_ID=42161
RELAY_PORT=9642

# Watchdog (scripts/relay_watchdog.sh)
RELAY_HOST=127.0.0.1
CHECK_INTERVAL=30
RESTART_DELAY=5
# Optional: a consumer log to scan for a stall marker.
CONSUMER_LOG=
STALL_PATTERN=no heads for 90s
