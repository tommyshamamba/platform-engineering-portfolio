# Copy to .env. Placeholders only: never commit a real key.
# Provider: deepseek | openai | anthropic | ollama (ollama runs locally and needs no key)
AI_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gate thresholds (module defaults shown)
AI_AUDIT_MIN_CONFIDENCE=0.65
AI_MAX_TRADES_PER_HOUR=10
AI_MIN_PROFIT_FLOOR_USD=30
AI_DECISION_CACHE_TTL=15

# Optional wallet-activity signal: comma-separated public addresses to watch
AI_SMART_MONEY_ENABLED=false
SMART_MONEY_WALLETS=
SMART_MONEY_LOOKBACK_BLOCKS=50
SMART_MONEY_MIN_CONSENSUS=2
